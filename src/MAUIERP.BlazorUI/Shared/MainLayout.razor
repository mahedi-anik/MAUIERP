@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject CustomAuthenticationStateProvider AuthProvider
@using MAUIERP.BlazorUI.Services
@using MudBlazor

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <!-- Standard Top Bar -->
    <MudAppBar Elevation="0" Class="top-bar" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="ToggleDrawer" Size="Size.Small" />

        <div class="logo-section">
            <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Small" Color="Color.Primary" />
            <MudText Typo="Typo.body1" Class="font-weight-bold">MAUI ERP</MudText>
        </div>

        <MudSpacer />


        <MudSpacer />

        <MudIconButton Icon="@Icons.Material.Filled.NotificationsNone" Color="Color.Inherit" Size="Size.Small" />

        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <MudAvatar Class="cursor-pointer" Size="Size.Small">
                    <MudImage Src="https://i.pravatar.cc/32" />
                </MudAvatar>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem OnClick="@(() => Navigation.NavigateTo("/profile"))">My Profile</MudMenuItem>
                <MudMenuItem OnClick="@(() => Navigation.NavigateTo("/settings"))">Settings</MudMenuItem>
                <MudDivider />
                <MudMenuItem OnClick="Logout" Class="text-danger">Logout</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <!-- Sidebar with modern navigation items -->
    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Persistent"
               Width="260px"
               Elevation="1"
               Class="sidebar"
               Dense="true">

        <MudNavMenu Dense="true">
            <!-- Dashboard -->
            <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">Dashboard</MudNavLink>
            
            <MudDivider Class="my-3" />

            <!-- Company Group -->
            <MudNavGroup Title="Company"
                         Icon="@Icons.Material.Filled.Dns"
                         @bind-Expanded="_serversExpanded">
                <MudNavLink Href="/company">Company</MudNavLink>
                <MudNavLink Href="/branch">Branch</MudNavLink>
            </MudNavGroup>

            <!-- Servers Group -->
            <MudNavGroup Title="Servers"
                         Icon="@Icons.Material.Filled.Dns"
                         @bind-Expanded="_serversExpanded">
                <MudNavLink Href="/servers/overview">Server Overview</MudNavLink>
                <MudNavLink Href="/servers/monitoring">Monitoring</MudNavLink>
                <MudNavLink Href="/servers/logs">Server Logs</MudNavLink>
            </MudNavGroup>

            <!-- Billing Group -->
            <MudNavGroup Title="Billing"
                         Icon="@Icons.Material.Filled.Receipt"
                         @bind-Expanded="_billingExpanded">
                <MudNavLink Href="/billing/invoices">Invoices</MudNavLink>
                <MudNavLink Href="/billing/payments">Payments</MudNavLink>
                <MudNavLink Href="/billing/subscriptions">Subscriptions</MudNavLink>
                <MudNavLink Href="/billing/transactions">Transactions</MudNavLink>
            </MudNavGroup>

            <!-- Users Group -->
            <MudNavGroup Title="Users"
                         Icon="@Icons.Material.Filled.People"
                         @bind-Expanded="_usersExpanded">
                <MudNavLink Href="/users/all">All Users</MudNavLink>
                <MudNavLink Href="/users/roles">Roles & Permissions</MudNavLink>
                <MudNavLink Href="/users/activity">User Activity</MudNavLink>
            </MudNavGroup>

            <!-- Security Group -->
            <MudNavGroup Title="Security"
                         Icon="@Icons.Material.Filled.Security"
                         @bind-Expanded="_securityExpanded">
                <MudNavLink Href="/security/audit-logs">Audit Logs</MudNavLink>
                <MudNavLink Href="/security/api-keys">API Keys</MudNavLink>
                <MudNavLink Href="/security/two-factor">Two-Factor Auth</MudNavLink>
                <MudNavLink Href="/security/sessions">Active Sessions</MudNavLink>
            </MudNavGroup>
            
            <!-- Reports Group (Optional) -->
            <MudNavGroup Title="Reports"
                         Icon="@Icons.Material.Filled.Assessment"
                         @bind-Expanded="_reportsExpanded">
                <MudNavLink Href="/reports/sales">Sales Reports</MudNavLink>
                <MudNavLink Href="/reports/financial">Financial Reports</MudNavLink>
            </MudNavGroup>
        </MudNavMenu>
    </MudDrawer>

    <!-- Main Content -->
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="content-area">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<style>
    /* Modern Light Theme - Most Common for ERP */
    .top-bar {
        background: white;
        color: #1e293b;
        border-bottom: 1px solid #e2e8f0;
        height: 64px;
        padding: 0 24px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }

    .logo-section {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .logo-section .mud-icon-root {
            color: #4f46e5;
        }

    /* Fixed Search Box Styling */
    .search-wrapper {
        position: relative;
        width: 300px;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        z-index: 1;
        color: #94a3b8;
        pointer-events: none;
    }

    .search-box {
        width: 100%;
    }

        .search-box .mud-input-root {
            padding-left: 36px !important;
            background: #f1f5f9;
            border-radius: 8px;
            font-size: 0.875rem;
        }

        .search-box .mud-input-outlined-border {
            border-color: #e2e8f0;
        }

        .search-box .mud-input-root:hover .mud-input-outlined-border {
            border-color: #cbd5e1;
        }

        .search-box .mud-input-root:focus-within .mud-input-outlined-border {
            border-color: #4f46e5;
            border-width: 2px;
        }

    /* Modern Sidebar - Dark Theme */
    .sidebar {
        background: #1e293b;
        color: #cbd5e1;
        border-right: none;
    }

        .sidebar .mud-nav-link {
            color: #cbd5e1;
            margin: 4px 8px;
            border-radius: 8px;
            transition: all 0.2s;
        }

            .sidebar .mud-nav-link:hover {
                background: rgba(255,255,255,0.08);
                color: white;
            }

            .sidebar .mud-nav-link.active {
                background: #4f46e5;
                color: white;
            }

                .sidebar .mud-nav-link.active .mud-nav-link-icon {
                    color: white;
                }

        .sidebar .mud-nav-group .mud-nav-group-title {
            color: #94a3b8;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 12px 16px 4px 16px;
        }

        .sidebar .mud-nav-group .mud-nav-link {
            padding-left: 52px;
        }

        .sidebar .mud-icon-root {
            color: #94a3b8;
        }

        .sidebar .mud-nav-link:hover .mud-icon-root {
            color: white;
        }

    /* Fix for dropdown menu positioning */
    .mud-popover {
        z-index: 9999;
    }

    .content-area {
        background: #f8fafc;
        padding: 24px;
        min-height: 100vh;
    }
</style>

@code {
    private bool _drawerOpen = true;
    
    // Track expanded states for each nav group
    private bool _serversExpanded = true;
    private bool _billingExpanded = false;
    private bool _usersExpanded = true;
    private bool _securityExpanded = false;
    private bool _reportsExpanded = false;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async void Logout()
    {
        await AuthProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login", true);
    }
}