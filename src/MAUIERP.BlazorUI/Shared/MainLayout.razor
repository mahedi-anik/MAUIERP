@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject CustomAuthenticationStateProvider AuthProvider
@using MAUIERP.BlazorUI.Services
@using MudBlazor

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="border-bottom">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="ToggleDrawer" Edge="Edge.Start" />
        <MudText Typo="Typo.h6" Class="ml-3">BRAINSTEM ERP</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.NotificationsNone" Color="Color.Inherit" />
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <MudAvatar Size="Size.Small" Class="ml-3">
                    <MudImage Src="https://i.pravatar.cc/100" />
                </MudAvatar>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem OnClick="Logout">Sign Out</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive" Width="280px" Class="py-3">
        @* Mobile Close Button - Only visible on small screens *@
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <div class="d-flex justify-end px-2">
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="ToggleDrawer" />
            </div>
        </MudHidden>

        <MudNavMenu Class="mud-width-full">
            <div class="px-4">
                <MudText Typo="Typo.h6">ERP</MudText>
            </div>
            
            <MudDivider Class="my-2" />
            
            <MudNavGroup Title="Dashboard" Icon="@Icons.Material.Filled.Dashboard" @bind-Expanded="_dashboardExpanded">
                <MudNavLink Href="/dashboard">Admin Dashboard</MudNavLink>
                <MudNavLink Href="/hr-dashboard">HR Dashboard</MudNavLink>
            </MudNavGroup>
            <div class="nav-section-label">MASTER DATA</div>
            <MudNavGroup Title="Company" Icon="@Icons.Material.Filled.Business" @bind-Expanded="_companyExpanded">
                <MudNavLink Href="/companies">Companies</MudNavLink>
                <MudNavLink Href="/branches">Branches</MudNavLink>
            </MudNavGroup>

            <div class="nav-section-label">OPERATIONS</div>
            <MudNavGroup Title="Infrastructure" Icon="@Icons.Material.Filled.Storage" @bind-Expanded="_serversExpanded">
                <MudNavLink Href="/servers/overview">Overview</MudNavLink>
                <MudNavLink Href="/servers/monitoring">Monitoring</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Billing" Icon="@Icons.Material.Filled.Receipt" @bind-Expanded="_billingExpanded">
                <MudNavLink Href="/billing/invoices">Invoices</MudNavLink>
                <MudNavLink Href="/billing/payments">Payments</MudNavLink>
            </MudNavGroup>

            <div class="nav-section-label">SYSTEM</div>
            <MudNavGroup Title="Settings" Icon="@Icons.Material.Filled.Settings" @bind-Expanded="_settingsExpanded">
                <MudNavLink Href="/users/all" Icon="@Icons.Material.Filled.People" IconColor="Color.Success">Users</MudNavLink>
                <MudNavLink Href="/security" Icon="@Icons.Material.Filled.Security" IconColor="Color.Info">Security</MudNavLink>
            </MudNavGroup>
            
            <MudNavGroup Title="Reports" Icon="@Icons.Material.Filled.Assessment" @bind-Expanded="_reportsExpanded">
                <MudNavLink Href="/reports/sales">Sales Reports</MudNavLink>
                <MudNavLink Href="/reports/financial">Financial Reports</MudNavLink>
            </MudNavGroup>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="bg-light-gray">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<style>
    .border-bottom {
        border-bottom: 1px solid #e2e8f0 !important;
        background-color: white !important;
        color: #1e293b !important;
    }

    .bg-light-gray {
        background-color: #f8fafc;
        min-height: 100vh;
    }

    .nav-section-label {
        color: #94a3b8;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 20px 24px 8px 24px;
        letter-spacing: 1px;
    }

    /* Modern Pill Active State */
    .mud-nav-link.active {
        background-color: #3b82f6 !important;
        color: white !important;
        margin: 4px 12px;
        border-radius: 8px;
    }

        .mud-nav-link.active .mud-nav-link-icon {
            color: white !important;
        }
</style>

@code {
    private bool _drawerOpen = true;

    private bool _dashboardExpanded = true;
    private bool _companyExpanded;
    private bool _serversExpanded;
    private bool _billingExpanded;
    private bool _settingsExpanded;
    private bool _reportsExpanded;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async void Logout()
    {
        await AuthProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login", true);
    }
}