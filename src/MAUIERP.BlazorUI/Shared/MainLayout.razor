@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject CustomAuthenticationStateProvider AuthProvider
@using MAUIERP.BlazorUI.Services
@using MudBlazor

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <!-- Premium Top Bar -->
    <MudAppBar Elevation="0" Class="premium-topbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       OnClick="ToggleDrawer"
                       Edge="Edge.Start"
                       Class="menu-toggle" />

        <div class="brand-section">
            <div class="brand-icon-small">
                <MudIcon Icon="@Icons.Material.Filled.Hub" />
            </div>
            <MudText Typo="Typo.h6" Class="brand-name">MAUI ERP</MudText>
        </div>

        <MudSpacer />

        <!-- Global Search -->
        <div class="global-search">
            <MudTextField T="string"
                          Placeholder="Search anything..."
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Margin="Margin.Dense"
                          Class="search-input" />
            <div class="search-shortcut">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">⌘K</MudChip>
            </div>
        </div>

        <MudSpacer />

        <!-- Action Icons -->
        <div class="topbar-actions">
            <MudTooltip Text="Notifications">
                <MudBadge Content="3" Color="Color.Error" Overlap="true" Dot="true">
                    <MudIconButton Icon="@Icons.Material.Filled.NotificationsNone"
                                   Color="Color.Inherit"
                                   Class="action-icon" />
                </MudBadge>
            </MudTooltip>

            <MudTooltip Text="Messages">
                <MudBadge Content="5" Color="Color.Success" Overlap="true" Dot="true">
                    <MudIconButton Icon="@Icons.Material.Filled.ChatBubbleOutline"
                                   Color="Color.Inherit"
                                   Class="action-icon" />
                </MudBadge>
            </MudTooltip>

            <MudTooltip Text="Settings">
                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Color="Color.Inherit"
                               Class="action-icon" />
            </MudTooltip>

            <MudDivider Vertical="true" FlexItem="true" Class="mx-2" Style="height: 32px;" />

            <!-- User Menu -->
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="user-menu">
                <ActivatorContent>
                    <div class="user-profile-trigger">
                        <MudAvatar Size="Size.Medium" Class="user-avatar">
                            <MudImage Src="https://i.pravatar.cc/48" />
                        </MudAvatar>
                        <div class="user-info">
                            <MudText Typo="Typo.body2" Class="user-name">John Doe</MudText>
                            <MudText Typo="Typo.caption" Class="user-role">Administrator</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
                    </div>
                </ActivatorContent>
                <ChildContent>
                    <div class="user-menu-header">
                        <MudAvatar Size="Size.Large">
                            <MudImage Src="https://i.pravatar.cc/64" />
                        </MudAvatar>
                        <div class="ml-3">
                            <MudText Typo="Typo.body1" Class="font-weight-bold">John Doe</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">john.doe@company.com</MudText>
                        </div>
                    </div>
                    <MudDivider Class="my-2" />
                    <MudMenuItem Icon="@Icons.Material.Filled.Person" OnClick="@(() => Navigation.NavigateTo("/profile"))">
                        My Profile
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Settings" OnClick="@(() => Navigation.NavigateTo("/settings"))">
                        Settings
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.HelpOutline">
                        Help Center
                    </MudMenuItem>
                    <MudDivider Class="my-2" />
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout" Class="logout-item">
                        Sign Out
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        </div>
    </MudAppBar>

    <!-- Modern Sidebar -->
    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Persistent"
               Width="280px"
               Elevation="0"
               Class="premium-sidebar">
        
        <div class="sidebar-content">
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="ToggleDrawer" Color="Color.Inherit" />
            <MudNavMenu Class="nav-menu">
                <!-- Dashboard -->
                <MudNavLink Href="/dashboard"
                            Icon="@Icons.Material.Filled.Dashboard"
                            Match="NavLinkMatch.All"
                            Class="nav-item">
                    <div class="nav-link-content">
                        <span>Dashboard</span>
                    </div>
                </MudNavLink>
                
                <div class="nav-divider"></div>
                <div class="nav-section-label">MASTER DATA</div>

                <!-- Company Group -->
                <MudNavGroup Title="Company"
                             Icon="@Icons.Material.Filled.Business"
                             @bind-Expanded="_companyExpanded"
                             Class="nav-group">
                    <MudNavLink Href="/companies" Class="nav-subitem">
                        <div class="nav-link-content">
                            <span>Companies</span>
@*                             <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">42</MudChip>
 *@                        </div>
                    </MudNavLink>
                    <MudNavLink Href="/branches" Class="nav-subitem">
                        <div class="nav-link-content">
                            <span>Branches</span>
                        </div>
                    </MudNavLink>
                </MudNavGroup>

                <div class="nav-divider"></div>
                <div class="nav-section-label">OPERATIONS</div>

                <!-- Servers Group -->
                <MudNavGroup Title="Infrastructure"
                             Icon="@Icons.Material.Filled.Dns"
                             @bind-Expanded="_serversExpanded"
                             Class="nav-group">
                    <MudNavLink Href="/servers/overview" Class="nav-subitem">Server Overview</MudNavLink>
                    <MudNavLink Href="/servers/monitoring" Class="nav-subitem">Monitoring</MudNavLink>
                    <MudNavLink Href="/servers/logs" Class="nav-subitem">Server Logs</MudNavLink>
                </MudNavGroup>

                <!-- Billing Group -->
                <MudNavGroup Title="Billing"
                             Icon="@Icons.Material.Filled.Receipt"
                             @bind-Expanded="_billingExpanded"
                             Class="nav-group">
                    <MudNavLink Href="/billing/invoices" Class="nav-subitem">Invoices</MudNavLink>
                    <MudNavLink Href="/billing/payments" Class="nav-subitem">Payments</MudNavLink>
                    <MudNavLink Href="/billing/subscriptions" Class="nav-subitem">Subscriptions</MudNavLink>
                    <MudNavLink Href="/billing/transactions" Class="nav-subitem">Transactions</MudNavLink>
                </MudNavGroup>

                <div class="nav-divider"></div>
                <div class="nav-section-label">SYSTEM</div>

                <!-- Users Group -->
                <MudNavGroup Title="Users"
                             Icon="@Icons.Material.Filled.People"
                             @bind-Expanded="_usersExpanded"
                             Class="nav-group">
                    <MudNavLink Href="/users/all" Class="nav-subitem">All Users</MudNavLink>
                    <MudNavLink Href="/users/roles" Class="nav-subitem">Roles & Permissions</MudNavLink>
                    <MudNavLink Href="/users/activity" Class="nav-subitem">User Activity</MudNavLink>
                </MudNavGroup>

                <!-- Security Group -->
                <MudNavGroup Title="Security"
                             Icon="@Icons.Material.Filled.Security"
                             @bind-Expanded="_securityExpanded"
                             Class="nav-group">
                    <MudNavLink Href="/security/audit-logs" Class="nav-subitem">Audit Logs</MudNavLink>
                    <MudNavLink Href="/security/api-keys" Class="nav-subitem">API Keys</MudNavLink>
                    <MudNavLink Href="/security/two-factor" Class="nav-subitem">Two-Factor Auth</MudNavLink>
                    <MudNavLink Href="/security/sessions" Class="nav-subitem">Active Sessions</MudNavLink>
                </MudNavGroup>
                
                <!-- Reports Group -->
                <MudNavGroup Title="Reports"
                             Icon="@Icons.Material.Filled.Assessment"
                             @bind-Expanded="_reportsExpanded"
                             Class="nav-group">
                    <MudNavLink Href="/reports/sales" Class="nav-subitem">Sales Reports</MudNavLink>
                    <MudNavLink Href="/reports/financial" Class="nav-subitem">Financial Reports</MudNavLink>
                </MudNavGroup>
            </MudNavMenu>
        </div>
    </MudDrawer>

    <!-- Overlay -->
    @if (_drawerOpen)
    {
        <div class="overlay" @onclick="ToggleDrawer"></div>
    }

    <!-- Main Content Area -->
    <MudMainContent Class="main-content">
        <div class="content-wrapper">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

<style>
    :root {
        --primary-color: #6366f1;
        --primary-hover: #4f46e5;
        --sidebar-bg: #0f172a;
        --sidebar-item-hover: rgba(255, 255, 255, 0.08);
        --topbar-bg: #ffffff;
        --content-bg: #f8fafc;
        --border-color: #e2e8f0;
    }

    /* Overlay */
    .overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 10; /* Make sure it's above other elements */
    }

    /* Premium TopBar */
    .premium-topbar {
        background: var(--topbar-bg);
        color: #1e293b;
        border-bottom: 1px solid var(--border-color);
        height: 72px;
        padding: 0 24px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        backdrop-filter: blur(10px);
    }

    .menu-toggle {
        margin-right: 16px;
    }

    .brand-section {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-right: 32px;
    }

    .brand-icon-small {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.25);
    }

        .brand-icon-small .mud-icon-root {
            color: white;
            font-size: 1.5rem;
        }

    .brand-name {
        font-weight: 800;
        letter-spacing: -0.5px;
        color: #1e293b;
    }

    /* Global Search */
    .global-search {
        position: relative;
        width: 400px;
    }

    .search-input {
        width: 100%;
    }

        .search-input .mud-input-root {
            background: #f1f5f9;
            border-radius: 12px;
            font-size: 0.875rem;
        }

        .search-input .mud-input-outlined-border {
            border-color: transparent;
        }

        .search-input:hover .mud-input-outlined-border {
            border-color: var(--border-color);
        }

    .search-shortcut {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
    }

        .search-shortcut .mud-chip {
            background: rgba(0, 0, 0, 0.05);
            font-weight: 600;
            font-size: 0.7rem;
            height: 22px;
        }

    /* TopBar Actions */
    .topbar-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .action-icon {
        transition: all 0.2s ease;
    }

        .action-icon:hover {
            background: rgba(0, 0, 0, 0.05);
        }

    /* User Profile Trigger */
    .user-profile-trigger {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 12px;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .user-profile-trigger:hover {
            background: rgba(0, 0, 0, 0.05);
        }

    .user-avatar {
        border: 2px solid var(--border-color);
    }

    .user-info {
        text-align: left;
    }

    .user-name {
        font-weight: 600;
        color: #1e293b;
        line-height: 1.2;
    }

    .user-role {
        color: #64748b;
        line-height: 1.2;
    }

    /* User Menu */
    .user-menu-header {
        display: flex;
        align-items: center;
        padding: 16px;
    }

    .logout-item {
        color: #ef4444;
    }

    /* Premium Sidebar */
    .premium-sidebar {
        background: var(--sidebar-bg);
        color: #cbd5e1;
        border-right: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        flex-direction: column;
    }

    .sidebar-content {
        flex: 1;
        overflow-y: auto;
        padding: 24px 0;
    }

    /* Navigation Menu */
    .nav-menu {
        padding: 0;
    }

    .nav-section-label {
        color: #64748b;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 20px 24px 8px 24px;
    }

    .nav-divider {
        height: 1px;
        background: rgba(255, 255, 255, 0.05);
        margin: 16px 24px;
    }

    .nav-item, .nav-group {
        margin: 4px 16px;
        border-radius: 12px;
        transition: all 0.2s ease;
    }

    .nav-item {
        color: #cbd5e1;
        padding: 12px 16px;
    }

        .nav-item:hover {
            background: var(--sidebar-item-hover);
            color: white;
        }

        .nav-item.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        }

    .nav-link-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
    }

    .nav-group .mud-nav-group-header {
        padding: 12px 16px;
        border-radius: 12px;
        color: #cbd5e1;
    }

    .nav-group:hover .mud-nav-group-header {
        background: var(--sidebar-item-hover);
        color: white;
    }

    .nav-subitem {
        color: #94a3b8;
        padding: 8px 16px 8px 48px;
        margin: 2px 0;
        border-radius: 8px;
        font-size: 0.875rem;
    }

        .nav-subitem:hover {
            background: var(--sidebar-item-hover);
            color: white;
        }

        .nav-subitem.active {
            background: rgba(102, 126, 234, 0.15);
            color: #a5b4fc;
            font-weight: 600;
        }

    /* Main Content */
    .main-content {
        background: var(--content-bg);
    }

    .content-wrapper {
        padding: 32px;
        min-height: calc(100vh - 72px);
    }

    /* Responsive Design */
    @@media (max-width: 960px) {
        .global-search {
            width: 200px;
        }

        .user-info {
            display: none;
        }

        .brand-name {
            font-size: 1rem;
        }
    }

    @@media (max-width: 600px) {
        .global-search {
            display: none;
        }

        .content-wrapper {
            padding: 16px;
        }
    }
</style>

@code {
    private bool _drawerOpen = true;

    // Track expanded states for each nav group
    private bool _companyExpanded = false;
    private bool _serversExpanded = false;
    private bool _billingExpanded = false;
    private bool _usersExpanded = false;
    private bool _securityExpanded = false;
    private bool _reportsExpanded = false;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async void Logout()
    {
        await AuthProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login", true);
    }
}