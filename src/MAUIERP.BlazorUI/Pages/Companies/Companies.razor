@page "/companies"
@using MAUIERP.ApplicationLayer.DTOs.MasterData
@using MAUIERP.ApplicationLayer.Features.Companies.Queries
@using MAUIERP.ApplicationLayer.Features.Companies.Commands
@using MediatR
@using MudBlazor
@using MudBlazorSeverity = MudBlazor.Severity
@inject IMediator Mediator
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using MAUIERP.ApplicationLayer.Common.Models
@using MAUIERP.Domain.Enums
@using MAUIERP.BlazorUI.Components
@using System.Threading

<MudText Typo="Typo.h4" Class="mb-4">Companies</MudText>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-4">
            <MudTable @ref="_table"
                      Dense="true"
                      Hover="true"
                      Loading="@_isLoading"
                      LoadingProgressColor="Color.Primary"
                      ServerData="@LoadServerData">
                
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Company List</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchTerm"
                                  Placeholder="Search"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="Size.Medium"
                                  Class="mt-0"
                                  Immediate="true"
                                  OnKeyUp="@OnSearchKeyUp"></MudTextField>
                    <MudIconButton Icon="@Icons.Material.Filled.Search"
                                   OnClick="@ReloadData"
                                   Color="Color.Primary" />
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="@OpenCreateDialog"
                               StartIcon="@Icons.Material.Filled.Add"
                               Class="ml-2">
                        Add Company
                    </MudButton>
                </ToolBarContent>
                
                <HeaderContent>
                    <MudTh>Code</MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh>Tax Number</MudTh>
                    <MudTh>Phone</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Country</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                
                <RowTemplate>
                    <MudTd DataLabel="Code">@context.Code</MudTd>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Tax Number">@context.TaxNumber</MudTd>
                    <MudTd DataLabel="Phone">@context.Phone</MudTd>
                    <MudTd DataLabel="Email">@context.Email</MudTd>
                    <MudTd DataLabel="Country">@context.Country</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)" Variant="Variant.Filled">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Info"
                                       OnClick="@(() => OpenEditDialog(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteCompany(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.AccountTree"
                                       Size="Size.Small"
                                       Color="Color.Success"
                                       OnClick="@(() => ManageBranches(context))" />
                    </MudTd>
                </RowTemplate>
                
                <PagerContent>
                    <MudTablePager PageSizeOptions="@(new int[] { 10, 20, 50, 100 })" />
                </PagerContent>
            </MudTable>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private MudTable<CompanyDto>? _table;
    private string _searchTerm = string.Empty;
    private bool _isLoading;
    private int _totalItems;
    private bool _hover = true;
    private bool _dense = true;
    
    private async Task<TableData<CompanyDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        _isLoading = true;
        
        try
        {
            var query = new GetCompaniesQuery(
                Page: state.Page + 1,
                PageSize: state.PageSize,
                SearchTerm: _searchTerm
            );
            
            var result = await Mediator.Send(query, cancellationToken);
            
            if (result.Succeeded && result.Data != null)
            {
                _totalItems = result.Data.TotalCount;
                
                return new TableData<CompanyDto>()
                {
                    Items = result.Data.Items.ToList(),
                    TotalItems = _totalItems
                };
            }
            
            return new TableData<CompanyDto>() { Items = new List<CompanyDto>(), TotalItems = 0 };
        }
        finally
        {
            _isLoading = false;
        }
    }
    
    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ReloadData();
        }
    }
    
    private async Task ReloadData()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }
    
    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters { ["IsEdit"] = false };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CompanyDialog>("Add Company", parameters, options);
        var result = await dialog.Result;
        
        if (!result!.Canceled && result.Data is true)
        {
            await ReloadData();
            Snackbar.Add("Company created successfully", MudBlazorSeverity.Success);
        }
    }
    
    private async Task OpenEditDialog(CompanyDto company)
    {
        var parameters = new DialogParameters
        {
            ["Company"] = company,
            ["IsEdit"] = true
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CompanyDialog>("Edit Company", parameters, options);
        var result = await dialog.Result;
        
        if (!result!.Canceled && result.Data is true)
        {
            await ReloadData();
            Snackbar.Add("Company updated successfully", MudBlazorSeverity.Success);
        }
    }
    
    private async Task DeleteCompany(CompanyDto company)
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = $"Are you sure you want to delete '{company.Name}'?",
            ["ButtonText"] = "Delete",
            ["Color"] = Color.Error
        };
        
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<DeleteConfirmationDialog>("Delete Company", parameters, options);
        var result = await dialog.Result;
        
        if (!result!.Canceled)
        {
            var command = new DeleteCompanyCommand(company.Id);
            var deleteResult = await Mediator.Send(command);
            
            if (deleteResult.Succeeded)
            {
                await ReloadData();
                Snackbar.Add("Company deleted successfully", MudBlazorSeverity.Success);
            }
            else
            {
                Snackbar.Add(string.Join(", ", deleteResult.Errors), MudBlazorSeverity.Error);
            }
        }
    }
    
    private void ManageBranches(CompanyDto company)
    {
        Snackbar.Add($"Managing branches for {company.Name}", MudBlazorSeverity.Info);
    }
    
    private Color GetStatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Inactive" => Color.Warning,
        "Suspended" => Color.Error,
        _ => Color.Default
    };
}